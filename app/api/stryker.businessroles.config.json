{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for what a business role says about itself: the ways it is gained and lost. businessRoleAccessModel.guard.test.js reads ontology/core.ttl, which is outside Stryker's sandbox, so it is waived below and runs in the normal suite.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.businessroles.config.js"
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/stryker-businessroles.json"
  },
  "mutate": [
    "src/lib/businessRoleAccessModel.js",
    "src/lib/businessRoleReview.js",
    "src/lib/businessRoleOwners.js",
    "src/lib/businessRoleOwnerSuggestion.js",
    "src/lib/businessRolePeople.js",
    "src/routes/details/businessRoleOwners.js",
    "src/lib/businessRoleOwnerImport.js",
    "src/routes/details/businessRoleOwnerImport.js",
    "src/routes/ingest/businessRoleOwners.js"
  ],
  "tests_comment": [
    "An explicit list, as in the sibling configs: Stryker runs in a sandbox copy of app/api, so a test that reads a file outside it would fail the dry run."
  ],
  "tests": [
    "src/lib/businessRoleAccessModel.test.js",
    "src/lib/businessRoleReview.test.js",
    "src/lib/businessRoleOwners.test.js",
    "src/lib/businessRoleOwnerSuggestion.test.js",
    "src/lib/businessRolePeople.test.js",
    "src/routes/details/businessRoleOwners.test.js",
    "src/lib/businessRoleOwnerImport.test.js",
    "src/routes/details/businessRoleOwnerImport.test.js",
    "src/routes/ingest/businessRoleOwners.test.js"
  ],
  "testExclusions": {
    "src/lib/businessRoleAccessModel.guard.test.js": "Compares the vocabulary with ontology/core.ttl, a file outside the Stryker sandbox."
  },
  "thresholds": {
    "high": 90,
    "low": 70
  },
  "concurrency": 2,
  "timeoutMS": 60000,
  "disableTypeChecks": false,
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral"
    ]
  }
}
