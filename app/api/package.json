{
  "name": "identity-atlas-api",
  "version": "3.4.0",
  "description": "Identity Atlas - Ingest & Read API",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "patch-package || true",
    "build:desktop": "node scripts/build-desktop.js",
    "build:desktop:skip-ui": "node scripts/build-desktop.js --skip-ui-build"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^5.14.0",
    "esbuild": "^0.28.0",
    "patch-package": "^8.0.1",
    "vitest": "^2.0.0"
  },
  "pkg": {
    "assets": [
      "src/db/migrations/*.sql",
      "src/openapi.yaml",
      "dist-frontend/**/*",
      "bundled-scripts/**/*",
      "node_modules/@embedded-postgres/windows-x64/native/**/*",
      "node_modules/embedded-postgres/**/*.js",
      "node_modules/@embedded-postgres/windows-x64/dist/**/*",
      "src/app-bundle.mjs"
    ]
  },
  "dependencies": {
    "cors": "^2.8.5",
    "embedded-postgres": "^16.1.1-beta.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.1",
    "pg-copy-streams": "^7.0.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  }
}
