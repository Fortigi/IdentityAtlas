{
  "name": "identity-atlas-api",
  "version": "3.4.0",
  "description": "Identity Atlas - Ingest & Read API",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:contract": "vitest run --config vitest.contract.config.js",
    "test:mutation": "stryker run",
    "test:mutation:incremental": "stryker run --incremental",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "postinstall": "patch-package || true",
    "build:node-launcher": "node ../desktop/scripts/build-node-launcher.mjs",
    "build:node-launcher:skip-ui": "node ../desktop/scripts/build-node-launcher.mjs --skip-ui-build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.0",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "4.1.0",
    "patch-package": "^8.0.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^4.1.0",
    "multer": "^2.1.1",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0",
    "re2": "^1.26.0",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  }
}
