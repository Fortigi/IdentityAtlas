diff --git a/node_modules/@embedded-postgres/windows-x64/dist/index.js b/node_modules/@embedded-postgres/windows-x64/dist/index.js
index 3b73726..2c217ae 100644
--- a/node_modules/@embedded-postgres/windows-x64/dist/index.js
+++ b/node_modules/@embedded-postgres/windows-x64/dist/index.js
@@ -1,4 +1,11 @@
 import path from 'path';
-export const pg_ctl = path.resolve(__dirname, '..', 'native', 'bin', 'pg_ctl.exe');
-export const initdb = path.resolve(__dirname, '..', 'native', 'bin', 'initdb.exe');
-export const postgres = path.resolve(__dirname, '..', 'native', 'bin', 'postgres.exe');
+import { fileURLToPath } from 'url';
+// EMBEDDED_PG_NATIVE_DIR lets the desktop .exe redirect binaries to an
+// extracted writable location (pkg snapshot paths can't be executed by Windows).
+// Guard import.meta.url: esbuild CJS bundles set import_meta={} so .url is
+// undefined — the && short-circuits before fileURLToPath is called.
+const nativeDir = process.env.EMBEDDED_PG_NATIVE_DIR
+  || (import.meta.url && path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..', 'native'));
+export const pg_ctl  = path.join(nativeDir, 'bin', 'pg_ctl.exe');
+export const initdb  = path.join(nativeDir, 'bin', 'initdb.exe');
+export const postgres = path.join(nativeDir, 'bin', 'postgres.exe');
