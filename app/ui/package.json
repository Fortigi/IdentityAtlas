{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npx playwright test",
    "test:e2e:sql": "bash scripts/e2e-sql.sh",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:ui": "npx playwright test --ui",
    "test:mutation": "npm run test:mutation:pilot && npm run test:mutation:hooks && npm run test:mutation:listhooks && npm run test:mutation:roles && npm run test:mutation:reports && npm run test:mutation:contextassistant && npm run test:mutation:contextupload && npm run test:mutation:contextinterviews && npm run test:mutation:surveys && npm run test:mutation:accountlinking",
    "test:mutation:pilot": "stryker run stryker.pilot.config.json",
    "test:mutation:hooks": "stryker run stryker.hooks.config.json",
    "test:mutation:listhooks": "stryker run stryker.listhooks.config.json",
    "test:mutation:roles": "stryker run stryker.roles.config.json",
    "test:mutation:reports": "stryker run stryker.reports.config.json",
    "test:mutation:contextassistant": "stryker run stryker.contextassistant.config.json",
    "test:mutation:contextupload": "stryker run stryker.contextupload.config.json",
    "test:mutation:contextinterviews": "stryker run stryker.contextinterviews.config.json",
    "test:mutation:surveys": "stryker run stryker.surveys.config.json",
    "test:mutation:accountlinking": "stryker run stryker.accountlinking.config.json"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.25.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.14.15",
    "exceljs": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "uuid": "^11.1.1"
  }
}
