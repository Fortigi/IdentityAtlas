{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing for the business role detail page: who answers for a role, how it is gained and lost, and how each person holds it.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.businessroles.config.js"
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/stryker-ui-businessroles.json"
  },
  "mutate": [
    "src/components/businessRoles/BusinessRoleOwners.jsx",
    "src/components/businessRoles/BusinessRoleOverview.jsx",
    "src/components/businessRoles/BusinessRoleLifecycle.jsx",
    "src/components/businessRoles/BusinessRoleParticipants.jsx",
    "src/components/businessRoles/BusinessRoleResources.jsx",
    "src/components/businessRoles/BusinessRoleMembers.jsx",
    "src/components/businessRoles/BusinessRoleOwnerImport.jsx",
    "src/components/businessRoles/WayChips.jsx",
    "src/components/businessRoles/RoleTypeCell.jsx",
    "src/components/HeldTick.jsx",
    "src/components/businessRoles/BusinessRoleCompositionReview.jsx",
    "src/components/businessRoles/review/ReviewWizard.jsx",
    "src/components/businessRoles/review/StepVerdict.jsx",
    "src/components/businessRoles/review/OwnershipStep.jsx",
    "src/components/businessRoles/review/HoldersPanel.jsx",
    "src/components/businessRoles/review/ReviewRecord.jsx",
    "src/components/businessRoles/review/reviewSteps.js",
    "src/components/businessRoles/review/ReviewRequestNotice.jsx",
    "src/components/reviewCampaigns/campaigns.js",
    "src/components/reviewCampaigns/CampaignForm.jsx",
    "src/components/reviewCampaigns/CampaignDetail.jsx",
    "src/components/admin/ReviewCampaignsTab.jsx",
    "src/components/contextOwner/ReviewRequestsBanner.jsx",
    "src/contexts/ReviewRequestsContext.jsx",
    "src/components/businessRoles/RoleSnapshot.jsx",
    "src/components/businessRoles/OwnerRolePage.jsx",
    "src/components/businessRoles/accessModel.js",
    "src/components/contextOwner/ownerPortfolios.js",
    "src/components/contextOwner/RoleBadge.jsx",
    "src/components/businessRoles/BusinessRoleRequestsAndReviews.jsx"
  ],
  "tests_comment": [
    "Standalone for the same reason as vitest.stryker.roles.config.js: Stryker sandboxes app/ui alone, so the normal include reaching ../../tools/crawlers/** would abort the run."
  ],
  "tests": [
    "src/components/businessRoles/*.test.{js,jsx}",
    "src/components/businessRoles/review/*.test.{js,jsx}",
    "src/components/reviewCampaigns/*.test.{js,jsx}",
    "src/components/admin/ReviewCampaignsTab.mount.test.jsx",
    "src/components/ContextOwnerPage.reviewRequests.mount.test.jsx",
    "src/components/contextOwner/ownerPortfolios.test.js"
  ],
  "thresholds": {
    "high": 90,
    "low": 70
  },
  "concurrency": 2,
  "timeoutMS": 60000,
  "disableTypeChecks": false,
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral"
    ]
  }
}
