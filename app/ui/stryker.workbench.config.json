{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation measurement of the role workbench (src/components/workbench/**): its model, labels, roles, columns, rule and save logic, the page, and the useWorkbench hook. Split out of stryker.contextinterviews.config.json (Nov 2026, #1548), which with these files could not finish inside the weekly job's 60 minutes. Same mutator settings as that config. NOT YET MEASURED as a scope of its own; like that config it has no `break` yet.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.stryker.workbench.config.js"
  },
  "reporters": [
    "clear-text",
    "json"
  ],
  "jsonReporter": {
    "fileName": "reports/stryker-ui-workbench.json"
  },
  "mutate": [
    "src/components/workbench/workbench.model.js",
    "src/components/workbench/workbench.labels.js",
    "src/components/workbench/workbench.cells.js",
    "src/components/workbench/workbench.roles.js",
    "src/components/workbench/useWorkbench.js",
    "src/components/workbench/CandidatePanel.jsx",
    "src/components/workbench/PeopleCells.jsx",
    "src/components/workbench/ColumnFilterMenu.jsx",
    "src/components/workbench/workbench.columns.js",
    "src/components/workbench/workbench.rule.js",
    "src/components/workbench/RoleRuleEditor.jsx",
    "src/components/workbench/WorkbenchControls.jsx",
    "src/components/workbench/WorkbenchGrid.jsx",
    "src/components/workbench/WorkbenchPage.jsx",
    "src/components/workbench/workbench.save.js",
    "src/components/workbench/useInvestigation.js",
    "src/components/workbench/InvestigationBar.jsx",
    "src/components/workbench/RoleSaveActions.jsx",
    "src/components/workbench/workbench.link.js",
    "src/components/workbench/useOpenLinked.js",
    "src/components/workbench/workbench.transposed.js",
    "src/components/workbench/WorkbenchColumnsGrid.jsx",
    "src/components/workbench/PeopleHeaderRows.jsx",
    "src/components/workbench/workbench.permissions.js",
    "src/components/workbench/PermissionFilters.jsx",
    "src/components/workbench/GridAndPanel.jsx",
    "src/components/workbench/PageStickyTable.jsx",
    "src/components/workbench/usePageVirtualRows.js"
  ],
  "mutator": {
    "excludedMutations": [
      "StringLiteral",
      "ObjectLiteral"
    ]
  },
  "thresholds": {
    "high": 90,
    "low": 70
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "disableTypeChecks": false
}
