{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "4646683802514293287"
    }
  },
  "parameters": {
    "entraTenantId": {
      "type": "string",
      "metadata": {
        "description": "Entra ID tenant (directory) GUID. Find it under Entra ID → Overview → Tenant ID."
      }
    },
    "entraClientId": {
      "type": "string",
      "metadata": {
        "description": "Entra ID App Registration (client) GUID. Find it on the registered app's Overview page. For an SPA app this is the only Entra ID you need — there is no client secret."
      }
    }
  },
  "variables": {
    "namePrefix": "[format('idatlas-{0}', take(uniqueString(resourceGroup().id), 7))]",
    "authSettings": {
      "AUTH_ENABLED": "true",
      "AUTH_TENANT_ID": "[parameters('entraTenantId')]",
      "AUTH_CLIENT_ID": "[parameters('entraClientId')]"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "patch-auth-settings",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "siteName": {
            "value": "[format('{0}-web', variables('namePrefix'))]"
          },
          "settings": {
            "value": "[union(list(format('{0}/config/appsettings', resourceId('Microsoft.Web/sites', format('{0}-web', variables('namePrefix')))), '2024-04-01').properties, variables('authSettings'))]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "1261716416741086691"
            }
          },
          "parameters": {
            "siteName": {
              "type": "string",
              "metadata": {
                "description": "App Service name (Step 1 created it as <namePrefix>-web)."
              }
            },
            "settings": {
              "type": "object",
              "metadata": {
                "description": "Full merged appsettings dictionary to write to the site. Caller is responsible for merging — this resource does a full PUT."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Web/sites/config",
              "apiVersion": "2024-04-01",
              "name": "[format('{0}/{1}', parameters('siteName'), 'appsettings')]",
              "properties": "[parameters('settings')]"
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "appUrl": {
      "type": "string",
      "metadata": {
        "description": "Public URL of the Identity Atlas web app — same as Step 1."
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', format('{0}-web', variables('namePrefix'))), '2024-04-01').defaultHostName)]"
    },
    "appHostname": {
      "type": "string",
      "metadata": {
        "description": "Hostname (without https://) — useful if you need to confirm the SPA redirect URI registered in Entra matches."
      },
      "value": "[reference(resourceId('Microsoft.Web/sites', format('{0}-web', variables('namePrefix'))), '2024-04-01').defaultHostName]"
    },
    "authEnabled": {
      "type": "bool",
      "metadata": {
        "description": "True. Always — this template only runs when you want auth on."
      },
      "value": true
    }
  }
}