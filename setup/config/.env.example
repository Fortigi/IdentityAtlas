# Identity Atlas Docker — Local Environment Variables (v5)
# Copy to .env and fill in your values. Never commit .env to git.

# Image channel — which Docker tag to pull (docker-compose.prod.yml only)
#   latest  — stable customer release (default, leave blank)
#   edge    — latest commit on main, may be unstable
#   5.2.1.0 — pin to a specific version
IMAGE_TAG=

# PostgreSQL
POSTGRES_DB=identity_atlas
POSTGRES_USER=identity_atlas
# REQUIRED for docker-compose.prod.yml — set a strong, unique value. The prod
# compose refuses to start if this is unset/empty. (Leave blank to fall back to
# the local dev default in docker-compose.yml.)
POSTGRES_PASSWORD=
# Host interface Postgres binds to. Default 127.0.0.1 = loopback only, NOT
# reachable from other hosts. Set to 0.0.0.0 only if you need off-host access
# (and firewall it). The web container always reaches Postgres internally.
POSTGRES_BIND_HOST=127.0.0.1

# Crawler API key (auto-generated by the web container on first start;
# the worker discovers it from the shared volume. Override here only when
# you want to skip the auto-generation step.)
CRAWLER_API_KEY=

# Microsoft Graph credentials (for the EntraID crawler — optional, can also
# be configured per-crawler via the in-browser wizard)
GRAPH_TENANT_ID=your-tenant-id
GRAPH_CLIENT_ID=your-client-id
GRAPH_CLIENT_SECRET=your-client-secret

# LLM credentials (for risk scoring — optional, currently disabled in v5)
LLM_PROVIDER=Anthropic
LLM_API_KEY=your-anthropic-or-openai-key

# How many distinct values each filter/attribute dropdown preloads per field
# (default 500, max 5000). Values past that page are still reachable through the
# dropdown's search box. Lower it — e.g. 5 — on a test deployment to exercise
# that path without importing hundreds of extra objects.
MATRIX_VALUE_PAGE_SIZE=
