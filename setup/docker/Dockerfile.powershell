# PowerShell runner for Identity Atlas crawlers, risk scoring, and account
# correlation.
#
# In v5 (postgres) the worker container does NOT install any database driver.
# All persistence happens via the Identity Atlas REST API; the worker only
# needs PowerShell + Microsoft Graph access. This removes the SqlServer
# PowerShell module dependency and shrinks the image substantially.
#
# Build context: repo root

# Plain Ubuntu, with PowerShell installed on top. This used to be
# mcr.microsoft.com/powershell:7.5-ubuntu-24.04, but Microsoft stopped rebuilding
# that image: the digest we pinned was built 2025-01-30 with PowerShell 7.5.0, and
# it was still the newest one behind the tag in Nov 2026. Its Ubuntu packages and
# PowerShell's bundled .NET libraries were never patched again, which the image
# CVE scan (image-scan.yml) turned into several hundred findings. Dependabot could
# not help, because there was no newer image to move to.
#
# Pinned by digest (SEC-2026-09 M-14) so a rebuild can't silently pick up a
# different image behind the same tag. Refresh tag and digest together;
# Dependabot (docker, /setup/docker) proposes new digests.
# ubuntu:24.04
FROM ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db

# PowerShell release, installed from Microsoft's GitHub release and checked
# against the SHA-256 that release publishes (hashes.sha256), so a tampered or
# swapped download fails the build. 7.6 is the LTS line (.NET 10); 7.5 ran on
# .NET 9, whose support ended in November 2026. Bump version and checksum
# together. tools/update-sbom-doc.py reads POWERSHELL_VERSION for the SBOM page.
ARG POWERSHELL_VERSION=7.6.10
ARG POWERSHELL_DEB_SHA256=81a5a944702b116ea74c88b01ba5f1f46b1cd7c42c36d85e1bae90de1230b4d1

# The environment the Microsoft image set, kept so crawler output is unchanged:
# en-US culture (dates, number formatting) and ICU-backed globalisation.
ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    PS_INSTALL_FOLDER=/opt/microsoft/powershell/7 \
    PSModuleAnalysisCachePath=/var/cache/microsoft/powershell/PSModuleAnalysisCache/ModuleAnalysisCache \
    POWERSHELL_DISTRIBUTION_CHANNEL=PSDocker-Ubuntu-24.04 \
    POWERSHELL_TELEMETRY_OPTOUT=1

# `apt-get upgrade` pulls every Ubuntu security update published since the base
# digest was cut, so a rebuild picks up OS fixes even between Dependabot bumps.
# curl is only needed for the download and is removed again.
RUN set -eux; \
    export DEBIAN_FRONTEND=noninteractive; \
    apt-get update; \
    apt-get upgrade -y; \
    apt-get install -y --no-install-recommends ca-certificates curl locales tzdata; \
    sed -i 's/^# *en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen; \
    locale-gen; \
    curl -fsSL -o /tmp/powershell.deb \
      "https://github.com/PowerShell/PowerShell/releases/download/v${POWERSHELL_VERSION}/powershell_${POWERSHELL_VERSION}-1.deb_amd64.deb"; \
    echo "${POWERSHELL_DEB_SHA256}  /tmp/powershell.deb" | sha256sum -c -; \
    apt-get install -y --no-install-recommends /tmp/powershell.deb; \
    rm /tmp/powershell.deb; \
    apt-get purge -y --auto-remove curl; \
    rm -rf /var/lib/apt/lists/*; \
    pwsh -NoLogo -NoProfile -Command '$PSVersionTable.PSVersion.ToString()'

WORKDIR /app

# Copy module loader (manifest + module file).
COPY setup/IdentityAtlas.psd1 setup/IdentityAtlas.psm1 ./setup/

# Copy only what the worker runs: the crawlers, the PowerShell SDK and the
# risk-scoring functions the module loader imports (setup/IdentityAtlas.psm1).
# The rest of tools/ is repository tooling (DoR automation, mutation testing,
# ratchets, generators) and does not belong in a runtime image.
COPY tools/crawlers/ ./tools/crawlers/
COPY tools/powershell-sdk/ ./tools/powershell-sdk/
COPY tools/riskscoring/ ./tools/riskscoring/
COPY setup/ ./setup/
# The demo crawler regenerates demo-company.json into this folder on every run,
# so it is the one image path the non-root worker (uid 1000) must be able to write.
COPY --chown=1000:1000 test/demo-dataset/ ./test/demo-dataset/

# Run as a non-root user (SEC-2026-09 M-14). uid/gid 1000 on purpose: it is the
# `node` user of the web image, which owns the shared /data/uploads volume and
# writes the 0600 built-in worker key the scheduler reads. The Ubuntu base image
# already ships uid 1000 (`ubuntu`); create one only if a future base does not.
# /data/uploads is created with that ownership so a volume first initialised by
# this container gets it too. Job trace directories left root-owned by older
# (root) worker images are repaired at startup — see WorkerVolume.ps1.
RUN (getent passwd 1000 >/dev/null || useradd --uid 1000 --user-group --create-home --shell /usr/sbin/nologin worker) \
 && mkdir -p /data/uploads \
 && chown 1000:1000 /data/uploads
USER 1000:1000

# Bake the release version into the image so the scheduler reports the same
# version the web container does (Get-WorkerVersion prefers $env:MODULE_VERSION).
# Passed as a build arg by docker-publish.yml and docker-compose.yml, mirroring
# app/api/Dockerfile. Without it the worker falls back to the ModuleVersion in
# the .psd1 — which on a release tag still holds the main dev version, so a
# stable deploy reported a dev-build worker.
# Declared last, after the COPY layers, so a version bump does not invalidate
# their build cache.
ARG MODULE_VERSION=""
ENV MODULE_VERSION=$MODULE_VERSION

# Default: run the scheduler loop (also accepts ad-hoc commands via docker exec)
CMD ["pwsh", "-File", "/app/setup/docker/scheduler.ps1"]
