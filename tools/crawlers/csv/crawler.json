{
  "type": "csv",
  "emits": {
    "principalTypes": ["User"],
    "resourceTypes": ["BusinessRole"],
    "contextTypes": ["OrgUnit"],
    "open": ["principalType", "resourceType", "contextType"]
  },
  "displayName": "CSV Import",
  "entryPoint": "Start-CSVCrawler.ps1",
  "dependsOn": [],
  "supportsFileUploads": true,
  "uploadFileExtensions": [".csv"],
  "configSchema": {
    "type": "object",
    "properties": {
      "csvFolder":  { "type": "string" },
      "systemName": { "type": "string" },
      "systemType": { "type": "string" }
    }
  },
  "postSyncHooks": ["buildContexts", "accountCorrelation"]
}
