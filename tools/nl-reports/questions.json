[
  {
    "id": "guests",
    "question": "all guest accounts",
    "expected": {
      "entity": "account",
      "conditions": [
        {
          "field": "userType",
          "op": "eq",
          "value": "Guest"
        }
      ]
    }
  },
  {
    "id": "guest-manager-or",
    "question": "I want to get a report of all guest accounts that don't have manager or where the manager is disabled",
    "expected": {
      "entity": "account",
      "conditions": [
        {
          "field": "userType",
          "op": "eq",
          "value": "Guest"
        },
        {
          "type": "group",
          "match": "any",
          "conditions": [
            {
              "relation": "manager",
              "quantifier": "none",
              "conditions": []
            },
            {
              "relation": "manager",
              "quantifier": "some",
              "conditions": [
                {
                  "field": "accountEnabled",
                  "op": "eq",
                  "value": false
                }
              ]
            }
          ]
        }
      ]
    }
  },
  {
    "id": "disabled-in-lic",
    "question": "I want a list of all users that are disabled that are still member of a group that contains LIC",
    "expected": {
      "entity": "account",
      "conditions": [
        {
          "field": "principalType",
          "op": "eq",
          "value": "User"
        },
        {
          "field": "accountEnabled",
          "op": "eq",
          "value": false
        },
        {
          "relation": "memberOf",
          "conditions": [
            {
              "field": "displayName",
              "op": "contains",
              "value": "LIC"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "enabled-in-license",
    "question": "enabled users that are in a group with License in the name, show their name, email and which groups",
    "expected": {
      "entity": "account",
      "conditions": [
        {
          "field": "principalType",
          "op": "eq",
          "value": "User"
        },
        {
          "field": "accountEnabled",
          "op": "eq",
          "value": true
        },
        {
          "relation": "memberOf",
          "conditions": [
            {
              "field": "displayName",
              "op": "contains",
              "value": "License"
            }
          ]
        }
      ]
    },
    "expectColumns": [
      "displayName",
      "email",
      "memberOf.names"
    ]
  },
