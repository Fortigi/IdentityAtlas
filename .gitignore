setup/config/*.json
!setup/config/*.template
.claude/
.env
test/nightly/results/
test/test-results.md
testResults.xml
test/test.secrets.json
test/demo-dataset/demo-company.json
test/demo-dataset/verify-results.json
node_modules/
.last-run.json
coverage/
coverage-contract/
# The published, versioned coverage report lives under docs/ and IS committed
# (coverage.yml renders it into the docs site). Keep it out of the broad
# `coverage/` ignore above, which otherwise matches a `coverage` dir at any depth.
!docs/coverage/
!docs/coverage/**
# The per-file coverage ratchet TOOL lives under tools/coverage/ and IS committed
# (only the generated app/*/coverage report dirs should be ignored).
!tools/coverage/
!tools/coverage/**
tools/csv-templates/demodata/
tools/csv-templates/demodataTransformed/
.claude/settings.local.json
Config/

# Desktop / portable launcher build artifacts
app/ui/dist/
app/ui/playwright-report/
app/ui/test-results/
app/api/dist-frontend/
app/api/bundled-scripts/
app/api/src/app-bundle.mjs
app/api/dist-node-launcher/
app/desktop/node_modules/

# Python bytecode cache (complexity tooling)
__pycache__/
*.pyc

# PowerShell mutation testing reports (PSMutant)
reports/
report/

# PowerShell Pester coverage artifacts
coverage.xml
pester-coverage.xml

# Test-GraphAPI / test-runner log artifacts
test/unit/logs/
